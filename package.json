{
  "name": "testextension",
  "displayName": "TestExtension",
  "description": "",
  "version": "0.0.1",
  "files": [
    "out/**",
    "runtime/**",
    "src/visualization/graphTemplate.html",
    "src/visualization/assets/**",
    "media/**",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:testextension.launchGraphView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "testextension-sidebar",
          "title": "Test Extension",
          "icon": "src/media/icon.svg"
        }
      ]
    },
    "views": {
      "testextension-sidebar": [
        {
          "type": "webview",
          "id": "testextension-main-view",
          "name": "Main"
        },
        {
          "icon": "",
          "type": "webview",
          "id": "testextension-settings-view",
          "name": "Settings"
        },
        {
          "type": "webview",
          "id": "testextension-graph-view",
          "name": "Test Extension View",
          "icon": "src/media/icon.svg",
          "when": "testextension.showGraphInSidebar && testextension.graphViewLaunched"
        }
      ]
    },
    "commands": [
      {
        "command": "testextension.startPythonRuntime",
        "title": "Start Python Runtime"
      },
      {
        "command": "testextension.stopPythonRuntime",
        "title": "Stop Python Runtime"
      },
      {
        "command": "testextension.pythonRuntimeStatus",
        "title": "Python Runtime Status"
      },
      {
        "command": "testextension.launchGraphView",
        "title": "Launch Graph View",
        "icon": "$(play)"
      }
    ],
    "configuration": {
      "title": "@Test Extension",
      "properties": {
        "testextension.normalizeTreemapWeight": {
          "type": "boolean",
          "default": true,
          "description": "Normalize treemap weight"
        },
        "testextension.normalizedTreemapMaxWeight": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "maximum": 10,
          "description": "Maximum node weight for the normalized treemap. Can be used to make nodes with small weight more visible. Only has an effect if 'Normalize treemap weight' is enabled."
        },
        "testextension.sortNodesByDescendingWeight": {
          "type": "boolean",
          "default": true,
          "description": "Sort treemap nodes in descending order"
        },
        "testextension.setFileLinesAsWeight": {
          "type": "boolean",
          "default": false,
          "description": "Use file lines as file weight. This causes file nodes to have some empty space depending on how much space nodes inside take"
        },
        "testextension.treemapPaddingPercent": {
          "type": "number",
          "default": 0.02,
          "minimum": 0,
          "maximum": 0.5,
          "description": "Percentage of the average side used as padding for treemap layout (0-1)."
        },
        "testextension.dynamicTreemapPadding": {
          "type": "boolean",
          "default": true,
          "description": "When enabled, the layout validator will progressively reduce paddingOuter for container nodes that contain collapsed or extreme-aspect-ratio children, halving the padding on each retry until the minimum is reached."
        },
        "testextension.capSiblingsWeightRatio": {
          "type": "number",
          "default": 50,
          "minimum": 0,
          "maximum": 100,
          "description": "Maximum allowed weight ratio between siblings in the treemap. Values ≤1 disable capping. Larger values allow more variation. Applied bottom-up at every parent level before normalization."
        },
        "testextension.graphViewLocation": {
          "type": "string",
          "default": "tab",
          "description": "Where to open the graph view. Use 'tab' for a regular editor tab or 'sidebar' for the Activity Bar sidebar."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "generate:settings-schema": "node ./scripts/generate-settings-schema.mjs",
    "compile": "pnpm run compile:extension && pnpm run compile:webview",
    "compile:extension": "pnpm run generate:settings-schema && tsc -p ./",
    "compile:webview": "tsc -p ./tsconfig.webview.json",
    "watch": "pnpm run generate:settings-schema && pnpm run compile:webview && tsc -watch -p ./",
    "watch:webview": "tsc -watch -p ./tsconfig.webview.json",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.110.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@a-issaoui/universal-msdf-generator": "^1.10.0",
    "@vscode/codicons": "^0.0.45",
    "@vscode/webview-ui-toolkit": "^1.4.0",
    "d3-hierarchy": "^3.1.2",
    "elkjs": "^0.11.1",
    "pixi-viewport": "^6.0.3",
    "pixi.js": "^8.18.1",
    "pnpm": "^10.33.0"
  }
}
